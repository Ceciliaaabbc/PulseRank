{
  "title": "PulseRank",
  "uid": "pulserank",
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "HTTP 请求速率 (按接口)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"pulserank\"}[1m])) by (uri, method)",
          "legendFormat": "{{method}} {{uri}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "GET /score 延迟分位数",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "http_server_requests_seconds{application=\"pulserank\", uri=\"/api/products/{productId}/score\", quantile=\"0.5\"}",
          "legendFormat": "P50"
        },
        {
          "expr": "http_server_requests_seconds{application=\"pulserank\", uri=\"/api/products/{productId}/score\", quantile=\"0.9\"}",
          "legendFormat": "P90"
        },
        {
          "expr": "http_server_requests_seconds{application=\"pulserank\", uri=\"/api/products/{productId}/score\", quantile=\"0.99\"}",
          "legendFormat": "P99"
        }
      ]
    },
    {
      "id": 3,
      "title": "多级缓存命中来源分布",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(rate(pulserank_score_source_total[1m])) by (source)",
          "legendFormat": "{{source}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "限流拒绝速率",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "rate(pulserank_ratelimit_rejected_total[1m])",
          "legendFormat": "429/s"
        }
      ]
    },
    {
      "id": 5,
      "title": "熔断器状态 (0=CLOSED 1=OPEN 2=HALF_OPEN)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "min": 0, "max": 2 }, "overrides": [] },
      "targets": [
        {
          "expr": "pulserank_circuitbreaker_state",
          "legendFormat": "state"
        }
      ]
    },
    {
      "id": 6,
      "title": "JVM 堆内存使用",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(jvm_memory_used_bytes{application=\"pulserank\", area=\"heap\"})",
          "legendFormat": "used"
        },
        {
          "expr": "sum(jvm_memory_committed_bytes{application=\"pulserank\", area=\"heap\"})",
          "legendFormat": "committed"
        }
      ]
    },
    {
      "id": 7,
      "title": "GC 暂停时间",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "rate(jvm_gc_pause_seconds_sum{application=\"pulserank\"}[1m])",
          "legendFormat": "{{action}}"
        }
      ]
    }
  ]
}
